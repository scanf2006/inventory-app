{
  "name": "inventory-app",
  "version": "3.8.51",
  "description": "A professional, mobile-first inventory management PWA designed for quick stocktaking and PDF reporting.",
  "main": "sw.js",
  "scripts": {
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "version:bump": "node scripts/bump-version.js",
    "release:patch": "npm run version:bump -- patch"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scanf2006/inventory-app.git"
  },
  "keywords": [
    "inventory",
    "PWA",
    "stocktaking",
    "offline-first"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "bugs": {
    "url": "https://github.com/scanf2006/inventory-app/issues"
  },
  "homepage": "https://github.com/scanf2006/inventory-app#readme",
  "devDependencies": {
    "jsdom": "^28.1.0",
    "jest": "^29.5.0",
    "@babel/core": "^7.21.0",
    "@babel/preset-env": "^7.21.0",
    "babel-jest": "^29.5.0"
  }
}
